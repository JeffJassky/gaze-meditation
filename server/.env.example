PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/gaze

SESSION_SECRET=change-me-in-production
SESSION_NAME=gaze.sid

# S3-compatible storage (AWS S3, R2, DO Spaces, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gaze
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# SendGrid
SENDGRID_API_KEY=
MAIL_FROM="Gaze <no-reply@gaze.app>"
MAIL_APP_NAME=Gaze
MAIL_APP_URL=http://localhost:5173
